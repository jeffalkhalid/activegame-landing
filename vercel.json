{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/u/:code",
      "destination": "/open/?p=invite&code=:code"
    },
    {
      "source": "/g/:id",
      "destination": "/open/?p=game&game=:id"
    },
    {
      "source": "/p/:id",
      "destination": "/open/?p=player&id=:id"
    },
    {
      "source": "/t/:id",
      "destination": "/open/?p=tournament&tournament=:id"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
